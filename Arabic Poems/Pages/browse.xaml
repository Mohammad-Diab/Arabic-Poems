<Page
    x:Class="Arabic_Poems.Pages.browse"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" FlowDirection="RightToLeft" Loading="Page_Loading">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <CommandBar DefaultLabelPosition="Right">
            <CommandBar.Content>
                <StackPanel>
                    <!-- ابحث في القصيدة الحالية - تصفية النتائج - الشعراء - القصائد-->
                    <AutoSuggestBox  Margin="8" Width="225" PlaceholderText="ابحث في القصيدة الحالية" QueryIcon="Find"/>
                </StackPanel>
            </CommandBar.Content>
            <AppBarButton Icon="OpenFile" Label="اختيار قصيدة"/>
            <AppBarButton Icon="ReShare" Label="تبديل"/>
            <AppBarSeparator/>
            <AppBarButton Icon="Copy" Label="نسخ"/>
            <AppBarButton Label="اضافة للمفضلة">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xEB51;"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator/>
            <AppBarButton Icon="Share" Label="مشاركة"/>
        </CommandBar>
        <Frame x:Name="PageFrame" Margin="0,50,0,0">
            <Frame.ContentTransitions>
                <TransitionCollection>
                    <NavigationThemeTransition/>
                </TransitionCollection>
            </Frame.ContentTransitions>
        </Frame>
        <Grid Visibility="Collapsed" VerticalAlignment="Bottom" Height="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="poem_name_tb" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Text="-"/>
            <TextBlock x:Name="poet_name_tb" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Text="-"/>
            <TextBlock x:Name="verse_count_tb" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Text="-"/>
        </Grid>
    </Grid>

</Page>
