<Page
    x:Class="Poetry.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Poetry"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" FlowDirection="RightToLeft" SizeChanged="Page_SizeChanged" Loaded="Page_Loaded">

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton Label="اختيار قصيدة" Icon="Home" Click="ViewPoem_Click"/>
            <AppBarButton Label="ابحث في القصيدة" Icon="Find" Click="ShowFindInPageDialogButton_Click"/>
            <AppBarButton Label="تحديد ملف" Icon="OpenFile" Click="LoadFile_Click"/>
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="الخط" Icon="Font" Click="FontSettingButton_Click"/>
                <AppBarButton Label="قائمة الحفظ" Icon="Flag" Click="FavouriteButton_Click"/>
                <AppBarSeparator/>
                <AppBarButton Label="عن" Icon="Favorite"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>


    <Pivot Tag="الشعر العربي" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" SelectionChanged="Pivot_SelectionChanged">
        <PivotItem Header="تصفح الموسوعة" Margin="0">
            <Grid>
                <ListBox x:Name="listView" Margin="0,30,0,5" FontSize="16" ScrollViewer.HorizontalScrollBarVisibility="Auto" Background="{x:Null}" FontFamily="KacstBook Kacst"/>
                <TextBlock x:Name="poem_name" HorizontalAlignment="Right" Margin="0,0,5,0" Text="القصيدة" VerticalAlignment="Top"/>
                <TextBlock x:Name="versifier_name" HorizontalAlignment="Left" Margin="5,0,0,0" Text="الشاعر" VerticalAlignment="Top"/>


                <!--<Grid x:Name="select_poem_grid" Background="#FFAFAFAF" Visibility="Collapsed" Margin="10,60,10,0" Height="380" VerticalAlignment="Top">
                    <Grid Margin="10,10,10,70">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="تصفية اسماء الشعراء" VerticalAlignment="Top" Margin="0,0,10,0" FontSize="18.667"/>
                        <ListBox x:Name="v_list" Margin="0,45,10,0" SelectionChanged="v_list_SelectionChanged" Background="{x:Null}" Foreground="White"/>
                        <TextBox PlaceholderText="تصفية القصائد" VerticalAlignment="Top" Margin="10,0,0,0" Grid.Column="1" FontSize="18.667"/>
                        <ListBox x:Name="p_list" Margin="10,45,0,0" Grid.Column="1" Background="{x:Null}" Foreground="White"/>
                    </Grid>
                    <Button Content="عرض القصيدة" Margin="0,0,10,10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="50" Width="200" Grid.Column="1" Background="#CCF0F0F0"/>
                    <Button Content="الغاء" Margin="0,0,215,10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Cancel_Click" Height="50" Width="200" Grid.Column="1" Background="#CCF0F0F0"/>
                </Grid>-->


                <Grid x:Name="search_in_page" Visibility="Collapsed" Margin="0,0,10,10" HorizontalAlignment="Right" Width="320" Height="36" VerticalAlignment="Bottom" Background="#FFC4C4C4" BorderBrush="#FF404040" BorderThickness="2">
                    <TextBox x:Name="search_box" TextWrapping="Wrap" Text="" PlaceholderText="ابحث في القصيدة الحالية" Margin="0,0,64,0" BorderBrush="{x:Null}" Background="White" TextChanged="FindInPageButton_TextChanged" BorderThickness="0" MaxLength="32" FontSize="18"/>
                    <Button Content="X" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="32" Click="HideFindInPageButton_Click" BorderThickness="1,0,0,0" BorderBrush="Black" Margin="0,0,0,0" Foreground="#FFFF3C19"/>
                    <Button Content="&gt;" HorizontalAlignment="Right" Margin="0,0,32,0" VerticalAlignment="Stretch" Width="32" Click="FindInPageButton_Click" BorderBrush="Black" BorderThickness="0,0,1,0"/>
                </Grid>
                <Grid Visibility="Collapsed" Margin="10,65,1,0" VerticalAlignment="Top" Height="80">
                    <Rectangle Fill="#FFF4F4F5" HorizontalAlignment="Left" Stroke="Black" Width="30" StrokeThickness="0"/>
                    <TextBlock x:Name="textBlock" HorizontalAlignment="Left" Margin="40,5,0,0" TextWrapping="Wrap" Text="فقلت لما غدوا أوصي قعيدتنا" VerticalAlignment="Top" FontFamily="KacstBook Kacst" FontSize="24" Foreground="#FF404040" SelectionHighlightColor="#FFF4F4F5"/>
                    <TextBlock x:Name="textBlock00" HorizontalAlignment="Left" Margin="120,40,0,0" TextWrapping="Wrap" Text="غدي بنيك فلن تلقيهم حقبا" VerticalAlignment="Top" FontFamily="KacstBook Kacst" FontSize="24" Foreground="Tomato" SelectionHighlightColor="SkyBlue"/>
                    <TextBlock x:Name="textBlock3" HorizontalAlignment="Left" Margin="0,30,0,0" TextWrapping="Wrap" Text="1" Width="30" TextAlignment="Center" Foreground="#FF404040" Height="20" VerticalAlignment="Top"/>
                </Grid>
                <Grid Visibility="Collapsed" HorizontalAlignment="Left" Margin="10,180,0,0" VerticalAlignment="Top" Height="60">
                    <Rectangle Fill="#FFF4F4F5" HorizontalAlignment="Left" Stroke="Black" Width="30" StrokeThickness="0"/>
                    <TextBlock x:Name="textBlock4" HorizontalAlignment="Left" Margin="35,5,0,0" TextWrapping="Wrap" Text="فقلت لما غدوا أوصي قعيدتنا" VerticalAlignment="Top" FontFamily="KacstBook Kacst" FontSize="32"/>
                    <TextBlock x:Name="textBlock5" HorizontalAlignment="Left" Margin="0,20,0,0" TextWrapping="Wrap" Text="2" Width="30" VerticalAlignment="Top" TextAlignment="Center" Foreground="#FF404040"/>
                </Grid>
            </Grid>
        </PivotItem>

        <PivotItem Header="البحث" Margin="0">
            <ScrollViewer x:Name="search_scroll" VerticalScrollBarVisibility="Disabled">
            <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" MinHeight="500">
                <TextBox x:Name="search_textbox" Margin="10,10,0,0" TextWrapping="Wrap" PlaceholderText="كلمة البحث" VerticalAlignment="Top" FontSize="22" HorizontalAlignment="Left" Width="348"/>
                <Rectangle x:Name="saparated" Fill="#FF404040" Width="3" Margin="405,40,0,40" Stroke="#FF404040" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" StrokeThickness="0"/>
                <Button x:Name="search_button" HorizontalAlignment="Left" Margin="358,10,0,0" VerticalAlignment="Top" Height="42" Width="42" Click="SearchButton_Click">
                    <SymbolIcon Symbol="Find"/>
                </Button>
                <TextBlock x:Name="textBlock_Copy" Text="البحث في:" HorizontalAlignment="Left" Margin="10,94,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="18"/>
                <ListView x:Name="versifier_list" HorizontalAlignment="Left" Margin="10,122,0,47" Width="390" Header="قائمة الشعراء" BorderBrush="#FF404040"/>
                <ListView x:Name="searchResult_list" Margin="415,85,5,30" Header="نتائج البحث" FontSize="20" ItemsSource="{Binding}" BorderBrush="#FF404040" SelectionChanged="SearchResultList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Visible">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=Line}" Tag="{Binding Path=Poem}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="searchInfo_stack" Orientation="Horizontal" Margin="405,0,5,5" VerticalAlignment="Bottom">
                    <TextBlock x:Name="resultCount_textblock" HorizontalAlignment="Left" TextWrapping="Wrap" Text="0 نتيجة" VerticalAlignment="Bottom" FontSize="14" Margin="25,0,25,0"/>
                    <Rectangle Margin="1" Fill="SteelBlue" StrokeThickness="0" Width="2"/>
                    <TextBlock x:Name="searchTime_textblock" Text="زمن البحث: 0 ثانية" TextWrapping="Wrap" VerticalAlignment="Bottom" FontSize="14" Margin="25,0,25,0"/>
                    <ProgressBar x:Name="Progress_bar" Height="12" VerticalAlignment="Stretch" Width="120" Margin="25,0,25,0" Visibility="Collapsed"/>
                </StackPanel>
                <CheckBox x:Name="ignore_difference" Content="تجاهل الفروق بين الحركات والهمزات ونحوها" HorizontalAlignment="Left" Margin="10,57,0,0" VerticalAlignment="Top" FontSize="16" IsChecked="True"/>
                <Grid x:Name="info_grid" Margin="415,20,5,0" VerticalAlignment="Top">
                    <TextBlock x:Name="versifierName_textblock" HorizontalAlignment="Left" Margin="5,5,0,0" Text="الشاعر" VerticalAlignment="Top" FontSize="16"/>
                    <TextBlock x:Name="poemName_textblock" HorizontalAlignment="Left" Margin="5,35,0,5" Text="القصيدة" VerticalAlignment="Top" FontSize="16"/>
                </Grid>
                <StackPanel x:Name="select_stack" Orientation="Horizontal"  HorizontalAlignment="Left" Margin="0,0,0,10" VerticalAlignment="Bottom">
                    <Button x:Name="selectAll_button" Content="تحديد الكل" Margin="10,0" Click="SelectAllButton_Click"/>
                    <Button x:Name="selectNone_button" Content="الغاء التحديد" Margin="10,0" Click="SelectNoneButton_Click"/>
                </StackPanel>
                <CheckBox x:Name="checkBox" Content="save poems in memory (this will speed up search but required more amount of RAM)" HorizontalAlignment="Right" Margin="0,5,10,0" VerticalAlignment="Top" FlowDirection="LeftToRight" Width="144" Height="75"/>
                <ComboBox x:Name="comboBox" HorizontalAlignment="Stretch" Margin="5,85,5,0" VerticalAlignment="Top" PlaceholderText="البحث في" Visibility="Collapsed">
                </ComboBox>
            </Grid>
            </ScrollViewer>
        </PivotItem>
    </Pivot>

</Page>
