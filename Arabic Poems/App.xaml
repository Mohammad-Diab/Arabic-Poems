<Application
    x:Class="Arabic_Poems.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Arabic_Poems"
    RequestedTheme="Light">
    <Application.Resources>
        <Style x:Key="RectangleStyle" TargetType="Rectangle">
            <Setter Property="Fill">
                <Setter.Value>
                    <LinearGradientBrush>
                        <GradientStop Color="LightGray" Offset="0.2"/>
                        <GradientStop Color="#FFE9E9E9" Offset="0.45"/>
                        <GradientStop Color="#FFE9E9E9" Offset="0.65"/>
                        <GradientStop Color="LightGray" Offset="0.8"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>

</Application>
