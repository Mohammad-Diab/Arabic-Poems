<Window x:Class="Make_poem_file.Poem_Maker_V2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Make_poem_file"
        mc:Ignorable="d"
        Title="Poem_Maker_V2" Height="400" Width="600" Loaded="Window_Loaded">
    <Grid>
        <Button Content="read files for first time" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="195" Click="FirstReadFile_Click"/>
        <Button Content="fast read file" HorizontalAlignment="Left" Margin="10,35,0,0" VerticalAlignment="Top" Width="195" Click="FastReadFile_Click"/>
        <Button x:Name="button" Content="Spill file and get long string and list of sp chars" HorizontalAlignment="Left" Margin="10,60,0,0" VerticalAlignment="Top" Width="276" Click="button_Click"/>
        <ListBox x:Name="listBox" HorizontalAlignment="Left" Margin="10,85,0,35" Width="244" SelectionChanged="listBox_SelectionChanged"/>
        <Button x:Name="button1_Copy" Content="Save to disk" HorizontalAlignment="Left" Margin="10,0,0,10" VerticalAlignment="Bottom" Width="75" Click="button1_Copy_Click"/>
        <TextBox x:Name="textBox" Height="25" Margin="259,106,59,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top"/>
        <TextBlock x:Name="textBlock" HorizontalAlignment="Left" Margin="259,85,0,0" TextWrapping="Wrap" Text="default text" VerticalAlignment="Top"/>
        <TextBox x:Name="textBox_Copy" HorizontalAlignment="Left" Height="25" Margin="259,160,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="274"/>
        <TextBlock x:Name="textBlock_Copy" HorizontalAlignment="Left" Margin="259,139,0,0" TextWrapping="Wrap" Text="New Text" VerticalAlignment="Top"/>
        <Button x:Name="button1" Content="apply to all" HorizontalAlignment="Left" Margin="259,211,0,0" VerticalAlignment="Top" Width="75" Click="button1_Click"/>
        <TextBlock x:Name="textBlock1" HorizontalAlignment="Right" Margin="0,101,9,0" TextWrapping="Wrap" Text="string count" VerticalAlignment="Top" Height="34" Width="45"/>
        <TextBlock x:Name="textBlock1_Copy" HorizontalAlignment="Right" Margin="0,154,10,0" TextWrapping="Wrap" Text="string count" VerticalAlignment="Top" Height="34" Width="44"/>
        <ListBox x:Name="listBox1" HorizontalAlignment="Left" Height="100" Margin="259,236,0,0" VerticalAlignment="Top" Width="323"/>
        <TextBlock x:Name="textBlock2" HorizontalAlignment="Left" Margin="259,341,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top"/>

    </Grid>
</Window>
