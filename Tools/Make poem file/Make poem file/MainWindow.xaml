<Window x:Class="Make_poem_file.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Make_poem_file"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="525">
    <Grid>
        <Button x:Name="button" Content="Write" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="109" Height="81" Click="button_Click"/>
        <Button x:Name="button_Copy" Content="Read" HorizontalAlignment="Right" Margin="0,10,10,0" VerticalAlignment="Top" Width="109" Height="81" Click="Read_Click"/>
        <Button x:Name="button1" Content="Test Encrypt and decrypt" Margin="33,0,43,131" VerticalAlignment="Bottom" Height="32" Click="Test_Click"/>
        <TextBox x:Name="text" Height="23" Margin="10,0,10,200" TextWrapping="Wrap" Text="Your text here" VerticalAlignment="Bottom"/>
        <TextBlock x:Name="textBlock" HorizontalAlignment="Left" Margin="10,0,0,110" TextWrapping="Wrap" Text="Result here" VerticalAlignment="Bottom"/>
        <TextBox x:Name="file_paths" Height="23" Margin="10,0,10,66" TextWrapping="Wrap" Text="File path here" VerticalAlignment="Bottom"/>
        <Button x:Name="button2" Content="Write file" HorizontalAlignment="Left" Margin="10,0,0,23" VerticalAlignment="Bottom" Width="75" Height="38" Click="WriteEncFile_Click"/>
        <Button x:Name="button2_Copy" Content="Read File" HorizontalAlignment="Right" Margin="0,0,10,23" VerticalAlignment="Bottom" Width="75" Height="38"/>
        <TextBlock x:Name="textBlock1" Margin="10,0,10,184" TextWrapping="Wrap" Text="Encrypt text here" VerticalAlignment="Bottom"/>

    </Grid>
</Window>
