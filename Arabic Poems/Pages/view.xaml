<Page
    x:Class="Arabic_Poems.Pages.view"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Arabic_Poems.Pages"
    xmlns:common="using:Arabic_Poems.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" FlowDirection="RightToLeft">
    <Page.Resources>
        <DataTemplate x:Key="TowVirses_Template">
            <Grid VerticalAlignment="Top">
                <Grid HorizontalAlignment="Left">
                    <Rectangle Fill="{ThemeResource SystemControlAccentAcrylicElementAccentMediumHighBrush}" Width="30" Margin="4,8"/>
                    <TextBlock Foreground="{ThemeResource ApplicationPageBackgroundThemeBrush}" Margin="4,8" Text="{Binding Path=VerseID}" VerticalAlignment="Center" FontSize="16" FontFamily="KacstBook Kacst" TextAlignment="Center"/>
                </Grid>
                <StackPanel Margin="40,4,8,4">
                    <TextBlock Margin="0,8" FontFamily="KacstBook Kacst" TextWrapping="Wrap" FontSize="28" HorizontalAlignment="Stretch" Text="{Binding Path=Line1}" TextAlignment="Left" VerticalAlignment="Top"/>
                    <TextBlock Margin="0,8" FontFamily="KacstBook Kacst" FontSize="28" TextWrapping="Wrap" HorizontalAlignment="Stretch" Text="{Binding Path=Line2}" TextAlignment="Right" VerticalAlignment="Top"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="OneVirse_Template">
            <Grid VerticalAlignment="Top">
                <Grid HorizontalAlignment="Left">
                    <Rectangle Fill="{ThemeResource SystemControlAccentAcrylicElementAccentMediumHighBrush}" Width="30" Margin="4,8"/>
                    <TextBlock Foreground="{ThemeResource ApplicationPageBackgroundThemeBrush}" Margin="4,8" Text="{Binding Path=VerseID}" VerticalAlignment="Center" FontSize="16" FontFamily="KacstBook Kacst" TextAlignment="Center"/>
                </Grid>
                <StackPanel Margin="40,4,8,4">
                    <TextBlock Margin="0,8" FontFamily="KacstBook Kacst" TextWrapping="Wrap" FontSize="28" HorizontalAlignment="Stretch" Text="{Binding Path=Line1}" TextAlignment="Center" VerticalAlignment="Top"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <CommandBar DefaultLabelPosition="Right">
            <CommandBar.Content>
                <StackPanel>
                    <!-- ابحث في القصيدة الحالية - تصفية النتائج - الشعراء - القصائد-->
                    <AutoSuggestBox  Margin="8" Width="225" PlaceholderText="ابحث في القصيدة الحالية" QueryIcon="Find"/>
                </StackPanel>
            </CommandBar.Content>
            <AppBarButton Icon="OpenFile" Label="اختيار قصيدة"/>
            <AppBarButton Icon="ReShare" Label="تبديل"/>
            <AppBarSeparator/>
            <AppBarButton Icon="Copy" Label="نسخ"/>
            <AppBarButton Label="اضافة للمفضلة">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xEB51;"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator/>
            <AppBarButton Icon="Share" Label="مشاركة"/>
        </CommandBar>
        <Grid Margin="12,48,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <TextBlock x:Name="title" Text="لا تعذله فإن العذل يولعه" Style="{StaticResource SubheaderTextBlockStyle}"/>
                <ListView x:Name="verses_list" Margin="0,64,0,0" ItemsSource="{Binding}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment"  Value="Stretch"></Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

            </ListView>
        </Grid>
        <ScrollViewer Margin="12,0,0,0" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <FontIcon FontSize="24" FontWeight="SemiLight" FontFamily="Segoe MDL2 Assets" Glyph="&#xE946;"/>
                        <TextBlock Margin="12,0,0,0" FontSize="24" FontWeight="SemiLight" OpticalMarginAlignment="TrimSideBearings" Text="عن الشاعر" />
                    </StackPanel>
                    <PersonPicture Margin="0,12,0,0" Width="128" HorizontalAlignment="Center" Height="128" VerticalAlignment="Top"/>
                    <TextBlock x:Name="poet_name_tb" Margin="0,12,0,0" Text="عنتر بن شداد" HorizontalAlignment="Center" VerticalAlignment="Top" Style="{StaticResource SubheaderTextBlockStyle}"/>
                
                    <TextBlock x:Name="poet_desc_tb" Margin="0,24,0,0" FontSize="18" FontWeight="SemiLight" Text="info"/>
                    <Rectangle Height="4" Fill="LightGray" HorizontalAlignment="Stretch" Margin="32,12,32,0"/>
                    <!--<Rectangle Margin="0,24,0,0" Style="{StaticResource RectangleStyle}" Width="300" Height="16"/>-->
                    <!--<Rectangle Margin="0,24,50,0" Style="{StaticResource RectangleStyle}" HorizontalAlignment="Stretch" Height="12"/>-->
                <!--<Rectangle Margin="0,24,180,0" Style="{StaticResource RectangleStyle}" HorizontalAlignment="Stretch" Height="12"/>-->
                <StackPanel Margin="0,36,0,0" Orientation="Horizontal">
                    <FontIcon FontSize="24" FontWeight="SemiLight" FontFamily="Segoe MDL2 Assets" Glyph="&#xE946;"/>
                    <TextBlock Margin="12,0,0,0" FontSize="24" FontWeight="SemiLight" OpticalMarginAlignment="TrimSideBearings" Text="عن القصيدة" />
                </StackPanel>
                <TextBlock Margin="0,12,0,0" x:Name="poem_desc_tb"  FontSize="18" FontWeight="SemiLight" Text="info"/>
                <!--<Rectangle Margin="0,24,50,0" Style="{StaticResource RectangleStyle}" HorizontalAlignment="Stretch" Height="12"/>
                <Rectangle Margin="0,24,180,0" Style="{StaticResource RectangleStyle}" HorizontalAlignment="Stretch" Height="12"/>-->
                <Rectangle Height="4" Fill="LightGray" HorizontalAlignment="Stretch" Margin="32,24,32,0"/>
                <StackPanel Margin="0,36,0,0" Orientation="Horizontal">
                        <FontIcon FontSize="24" FontWeight="SemiLight" FontFamily="Segoe MDL2 Assets" Glyph="&#xE77B;"/>
                        <TextBlock Margin="12,0,0,0" FontSize="24" FontWeight="SemiLight" OpticalMarginAlignment="TrimSideBearings">
                            <Run Text="اقرأ المزيد لـ "/>
                            <Run Text="{Binding ElementName=poet_name_tb,Path=Text,Mode=OneWay}"/>
                        </TextBlock>
                </StackPanel>
                <ListView x:Name="more_list" SelectionMode="None" ItemsSource="{Binding}" Margin="0,12,24,0" VerticalAlignment="Top">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <HyperlinkButton Visibility="{Binding Path=Visibility,Mode=TwoWay}" Tag="{Binding Path=Tag}" HorizontalAlignment="Stretch" Foreground="RoyalBlue" HorizontalContentAlignment="Stretch" Click="ViewPoem_Click">
                                    <StackPanel HorizontalAlignment="Left" RelativePanel.AlignTopWithPanel="True" Orientation="Horizontal">
                                        <SymbolIcon Symbol="Highlight"/>
                                        <TextBlock Margin="10,0" Text="{Binding Path=Name}"/>
                                    </StackPanel>
                                </HyperlinkButton>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </Grid>
</Page>
