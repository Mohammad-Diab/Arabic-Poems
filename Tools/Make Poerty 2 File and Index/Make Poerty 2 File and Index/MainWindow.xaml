<Window x:Class="Make_Poerty_2_File_and_Index.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Make_Poerty_2_File_and_Index"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="525">
    <Grid>
        <Button Content="Browse" HorizontalAlignment="Right" Margin="0,15,10,0" VerticalAlignment="Top" Width="75" Click="SelectSourceButton_Click"/>
        <Button Content="Browse" HorizontalAlignment="Right" Margin="0,57,10,0" VerticalAlignment="Top" Width="75" Click="SelectDestinationButton_Click"/>
        <TextBox x:Name="tbx_source_folder" Height="23" Margin="140,15,90,0" Text="F:\Other User\Desktop\Poerty\Dewan_demo" TextWrapping="Wrap" VerticalAlignment="Top"/>
        <TextBox x:Name="tbx_destination_folder" Height="23" Margin="140,56,90,0" TextWrapping="Wrap" VerticalAlignment="Top"/>
        <TextBlock x:Name="textBlock" HorizontalAlignment="Left" Margin="10,9,0,0" TextWrapping="Wrap" Text="Folder contains poems file" VerticalAlignment="Top" Width="85" TextAlignment="Center"/>
        <TextBlock x:Name="textBlock1" HorizontalAlignment="Left" Margin="10,51,0,0" TextWrapping="Wrap" Text="Store poems and indises in" VerticalAlignment="Top" Width="85" TextAlignment="Center"/>
        <ProgressBar Height="21" Margin="100,0,100,25" VerticalAlignment="Bottom"/>
        <TextBlock x:Name="tbx_current_mission" HorizontalAlignment="Left" Margin="100,252,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="317" TextAlignment="Center"/>
        <Rectangle Fill="#FFF4F4F5" Margin="10,125,10,72" Stroke="Black"/>
        <TextBlock x:Name="textBlock3" HorizontalAlignment="Left" Margin="18,133,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run FlowDirection="RightToLeft" Text="ملخص"/></TextBlock>
        <Button x:Name="start" Content="Start" Margin="0,95,10,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="140" Click="StartButton_Click"/>

    </Grid>
</Window>
